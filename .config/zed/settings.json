// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "disable_ai": true,
  "hard_tabs": false,
  "relative_line_numbers": "enabled",
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "format_on_save": "off",
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "project_panel": {
    "dock": "right"
  },
  "vim_mode": true,
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "base_keymap": "VSCode",
  "tab_bar": {
    "show": false,
  },
  "tabs": {
    "file_icons": false,
  },
  "minimap": {
    "show": "never",
  },
  "autosave": "on_focus_change",
  "buffer_font_family": "JetBrains Mono",
  "show_whitespaces": "none",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Nord Dark",
  },
}
